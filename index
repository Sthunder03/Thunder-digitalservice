    <!-- Interactive Logic: Service Filters, Lightbox, Live Editor & Clean HTML Exporter -->
    <script>
        let isEditMode = false;
        let currentModalTarget = null;
        let currentModalType = null;
        let offerPresetIndex = 0;

        const offerPresets = [
            "Zero Service Fee on Your First Form Fill-Up or CV Creation!",
            "Flat ₹20 OFF on Your First Ticket Booking or CV Creation!"
        ];

        // Reliable SVG data-URI fallback generator if any external image fails to load
        function createWorkspaceFallbackSVG(title, subtitle) {
            const safeTitle = String(title || 'Thunder_digital_service').replace(/&/g, '&amp;').replace(/</g, '&lt;');
            const safeSub = String(subtitle || 'Digital Service Center').replace(/&/g, '&amp;').replace(/</g, '&lt;');
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
                <defs>
                    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#1e1b4b"/>
                        <stop offset="100%" stop-color="#312e81"/>
                    </linearGradient>
                </defs>
                <rect width="800" height="600" fill="url(#bg)"/>
                <circle cx="680" cy="120" r="140" fill="#4f46e5" opacity="0.25"/>
                <circle cx="120" cy="500" r="180" fill="#3b82f6" opacity="0.2"/>
                <rect x="260" y="170" width="280" height="175" rx="16" fill="#0f172a" stroke="#6366f1" stroke-width="4"/>
                <rect x="280" y="190" width="240" height="125" rx="8" fill="#1e293b"/>
                <path d="M385 220 L420 250 L398 250 L412 285 L375 252 L397 252 Z" fill="#fbbf24"/>
                <rect x="220" y="345" width="360" height="16" rx="8" fill="#cbd5e1"/>
                <text x="400" y="425" font-family="sans-serif" font-size="28" font-weight="bold" fill="#ffffff" text-anchor="middle">${safeTitle}</text>
                <text x="400" y="460" font-family="sans-serif" font-size="18" fill="#c7d2fe" text-anchor="middle">${safeSub}</text>
            </svg>`;
            return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
        }

        // Toast Notification Helper
        function showToast(message, isError = false) {
            const toast = document.getElementById('toast-box');
            const toastMsg = document.getElementById('toast-message');
            const toastIcon = document.getElementById('toast-icon');

            toastMsg.textContent = message;
            toastIcon.className = isError
                ? 'fa-solid fa-circle-exclamation text-rose-400 text-base'
                : 'fa-solid fa-circle-check text-emerald-400 text-base';

            toast.classList.remove('-translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            clearTimeout(window.toastTimer);
            window.toastTimer = setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('-translate-y-24', 'opacity-0');
            }, 3200);
        }

        // Service Category Filter Tabs
        function filterServices(category) {
            const groups = document.querySelectorAll('[data-service-group]');
            const buttons = document.querySelectorAll('[data-filter-btn]');

            groups.forEach(group => {
                const groupName = group.getAttribute('data-service-group');
                if (category === 'all' || groupName === category) {
                    group.classList.remove('hidden');
                } else {
                    group.classList.add('hidden');
                }
            });

            buttons.forEach(btn => {
                const btnCat = btn.getAttribute('data-filter-btn');
                if (btnCat === category) {
                    btn.className = 'px-5 py-2.5 rounded-xl text-sm font-bold bg-brand-600 text-white shadow-md shadow-brand-600/20 transition cursor-pointer';
                } else {
                    btn.className = 'px-5 py-2.5 rounded-xl text-sm font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer';
                }
            });
        }

        // Gallery Lightbox Preview
        function openLightbox(figureEl) {
            if (isEditMode) return; // Allow image URL editing instead of opening lightbox in Edit Mode
            const img = figureEl.querySelector('img');
            const titleEl = figureEl.querySelector('h4');
            const descEl = figureEl.querySelector('p');

            if (!img) return;
            document.getElementById('lightbox-img').src = img.src;
            document.getElementById('lightbox-title').textContent = titleEl ? titleEl.textContent.trim() : 'Workspace Photo';
            document.getElementById('lightbox-desc').textContent = descEl ? descEl.textContent.trim() : '';

            const modal = document.getElementById('lightbox-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeLightbox() {
            const modal = document.getElementById('lightbox-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // Cycle Offer Text in Edit Mode
        function cycleOfferPreset() {
            offerPresetIndex = (offerPresetIndex + 1) % offerPresets.length;
            const offerEl = document.getElementById('hero-offer-text');
            if (offerEl) {
                offerEl.textContent = offerPresets[offerPresetIndex];
                showToast('Switched Special Offer text!');
            }
        }

        // Toggle Live Customize Mode
        function toggleEditMode() {
            isEditMode = !isEditMode;
            const toggleBtn = document.getElementById('toggle-edit-btn');
            const toggleText = document.getElementById('toggle-edit-text');
            const statusBadge = document.getElementById('edit-status-badge');
            const editMapBtn = document.getElementById('edit-map-btn');
            const swapOfferBtn = document.getElementById('swap-offer-btn');

            const editableTexts = document.querySelectorAll('[data-editable="text"]');
            const editableImgs = document.querySelectorAll('[data-editable-img="true"]');
            const editableLinks = document.querySelectorAll('[data-editable-link]');

            if (isEditMode) {
                toggleBtn.classList.remove('bg-brand-600', 'hover:bg-brand-500');
                toggleBtn.classList.add('bg-amber-600', 'hover:bg-amber-500');
                toggleText.textContent = 'Done Editing';
                statusBadge.classList.remove('hidden');
                statusBadge.classList.add('flex');
                if (editMapBtn) editMapBtn.classList.remove('hidden');
                if (swapOfferBtn) swapOfferBtn.classList.remove('hidden');

                editableTexts.forEach(el => {
                    el.setAttribute('contenteditable', 'true');
                    el.classList.add('outline-dashed', 'outline-2', 'outline-amber-400/80', 'rounded-md', 'px-1');
                });

                editableImgs.forEach(img => {
                    img.classList.add('ring-4', 'ring-amber-400', 'cursor-pointer');
                });

                editableLinks.forEach(link => {
                    link.classList.add('ring-2', 'ring-amber-400', 'ring-offset-2');
                });

                showToast('Edit Mode ON: Click any text, photo, or button to customize.');
            } else {
                toggleBtn.classList.remove('bg-amber-600', 'hover:bg-amber-500');
                toggleBtn.classList.add('bg-brand-600', 'hover:bg-brand-500');
                toggleText.textContent = 'Customize Page';
                statusBadge.classList.add('hidden');
                statusBadge.classList.remove('flex');
                if (editMapBtn) editMapBtn.classList.add('hidden');
                if (swapOfferBtn) swapOfferBtn.classList.add('hidden');

                editableTexts.forEach(el => {
                    el.removeAttribute('contenteditable');
                    el.classList.remove('outline-dashed', 'outline-2', 'outline-amber-400/80', 'rounded-md', 'px-1');
                });

                editableImgs.forEach(img => {
                    img.classList.remove('ring-4', 'ring-amber-400', 'cursor-pointer');
                });

                editableLinks.forEach(link => {
                    link.classList.remove('ring-2', 'ring-amber-400', 'ring-offset-2');
                });

                const brandEl = document.querySelector('header [data-editable="text"]');
                if (brandEl && brandEl.textContent.trim()) {
                    document.title = brandEl.textContent.trim() + ' - Recharges, Bill Payments, Form Fill-Ups & Tickets';
                }

                showToast('Changes saved! Click "Download index.html" to export.');
            }
        }

        // Intercept Image & Button Link Clicks in Edit Mode
        document.addEventListener('click', function (e) {
            if (!isEditMode) return;

            const imgTarget = e.target.closest('[data-editable-img="true"]');
            if (imgTarget) {
                e.preventDefault();
                e.stopPropagation();
                openModal(
                    imgTarget,
                    'image',
                    'Change Photo URL',
                    'Paste a direct image link (Unsplash, Imgur, or hosted image URL):',
                    imgTarget.getAttribute('src')
                );
                return;
            }

            const linkTarget = e.target.closest('[data-editable-link]');
            if (linkTarget && !e.target.hasAttribute('contenteditable')) {
                e.preventDefault();
                e.stopPropagation();
                const linkType = linkTarget.getAttribute('data-editable-link');
                let title = 'Edit Button Link';
                let desc = 'Enter destination URL:';
                if (linkType === 'tel') {
                    title = 'Edit Call Phone Number';
                    desc = 'Enter phone link in format tel:+919876543210:';
                } else if (linkType === 'whatsapp') {
                    title = 'Edit WhatsApp Link';
                    desc = 'Enter WhatsApp link (e.g., https://wa.me/919876543210?text=Hello):';
                } else if (linkType === 'maps') {
                    title = 'Edit Google Maps Navigation Link';
                    desc = 'Paste your Google Maps location URL:';
                } else if (linkType === 'mailto') {
                    title = 'Edit Email Link';
                    desc = 'Enter email link in format mailto:you@example.com:';
                } else if (linkType === 'facebook') {
                    title = 'Edit Facebook Page URL';
                    desc = 'Paste your Facebook page or profile link (e.g., https://www.facebook.com/yourpage):';
                } else if (linkType === 'instagram') {
                    title = 'Edit Instagram Profile URL';
                    desc = 'Paste your Instagram profile link (e.g., https://www.instagram.com/yourhandle):';
                }
                openModal(linkTarget, 'link', title, desc, linkTarget.getAttribute('href'));
            }
        }, true);

        // Modal Controls
        function openModal(targetEl, type, title, desc, currentValue) {
            currentModalTarget = targetEl;
            currentModalType = type;
            document.getElementById('modal-title').textContent = title;
            document.getElementById('modal-desc').textContent = desc;
            const input = document.getElementById('modal-input');
            input.value = currentValue || '';
            const modal = document.getElementById('link-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            input.focus();
        }

        function closeModal() {
            const modal = document.getElementById('link-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            currentModalTarget = null;
            currentModalType = null;
        }

        function saveModalValue() {
            const newVal = document.getElementById('modal-input').value.trim();
            if (!newVal || !currentModalTarget) {
                closeModal();
                return;
            }

            if (currentModalType === 'image') {
                currentModalTarget.setAttribute('src', newVal);
                showToast('Photo updated!');
            } else if (currentModalType === 'link') {
                const linkType = currentModalTarget.getAttribute('data-editable-link');
                currentModalTarget.setAttribute('href', newVal);
                // Sync all matching social links (Facebook / Instagram) across header, hero, contact, and footer
                if (linkType === 'facebook' || linkType === 'instagram') {
                    document.querySelectorAll(`[data-editable-link="${linkType}"]`).forEach(el => {
                        el.setAttribute('href', newVal);
                    });
                    showToast(`All ${linkType.charAt(0).toUpperCase() + linkType.slice(1)} links updated!`);
                } else {
                    showToast('Link updated!');
                }
            } else if (currentModalType === 'map') {
                let cleanSrc = newVal;
                if (newVal.includes('<iframe')) {
                    const match = newVal.match(/src=["']([^"']+)["']/);
                    if (match && match[1]) cleanSrc = match[1];
                }
                currentModalTarget.setAttribute('src', cleanSrc);
                showToast('Map embed URL updated!');
            }
            closeModal();
        }

        function editMapEmbed() {
            const iframe = document.getElementById('google-map-iframe');
            openModal(
                iframe,
                'map',
                'Update Embedded Map URL',
                'Go to Google Maps -> Share -> Embed a map -> Copy HTML or src URL and paste below:',
                iframe.getAttribute('src')
            );
        }

        // Copy Shop Address Helper
        function copyAddress() {
            const addressEl = document.getElementById('shop-address-text');
            const textToCopy = addressEl ? addressEl.textContent.trim() : '';
            copyTextToClipboard(textToCopy, 'Shop address copied to clipboard!');
        }

        // Copy & Share Page Link Helper
        function sharePage() {
            copyTextToClipboard(window.location.href, 'Page link copied! Ready to share on WhatsApp.');
        }

        function copyTextToClipboard(text, successMsg) {
            try {
                const tempInput = document.createElement('textarea');
                tempInput.value = text;
                tempInput.style.position = 'fixed';
                tempInput.style.opacity = '0';
                document.body.appendChild(tempInput);
                tempInput.select();
                document.execCommand('copy');
                document.body.removeChild(tempInput);
                showToast(successMsg);
            } catch (err) {
                showToast('Could not copy automatically.', true);
            }
        }

        // Download Clean Standalone index.html (Excludes Editor Toolbar & Edit Modals)
        function downloadCustomHTML() {
            if (isEditMode) {
                toggleEditMode();
            }

            const docClone = document.documentElement.cloneNode(true);

            // Remove editor-only UI elements so the published public site is clean
            const editorToolbar = docClone.querySelector('#editor-toolbar');
            if (editorToolbar) editorToolbar.remove();

            const linkModal = docClone.querySelector('#link-modal');
            if (linkModal) linkModal.remove();

            const editMapBtn = docClone.querySelector('#edit-map-btn');
            if (editMapBtn) editMapBtn.remove();

            const swapOfferBtn = docClone.querySelector('#swap-offer-btn');
            if (swapOfferBtn) swapOfferBtn.remove();

            // Reset toast & lightbox states in exported clone
            const toastClone = docClone.querySelector('#toast-box');
            if (toastClone) {
                toastClone.classList.add('-translate-y-24', 'opacity-0');
                toastClone.classList.remove('translate-y-0', 'opacity-100');
            }

            const lightboxClone = docClone.querySelector('#lightbox-modal');
            if (lightboxClone) {
                lightboxClone.classList.add('hidden');
                lightboxClone.classList.remove('flex');
            }

            const htmlContent = '<!DOCTYPE html>\n' + docClone.outerHTML;
            const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
            const url = URL.createObjectURL(blob);

            const downloadAnchor = document.createElement('a');
            downloadAnchor.href = url;
            downloadAnchor.download = 'index.html';
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            document.body.removeChild(downloadAnchor);
            URL.revokeObjectURL(url);

            showToast('Downloaded clean index.html ready for free hosting!');
        }

        // Close modals on Escape key
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeModal();
                closeLightbox();
            }
        });
    </script>

</body></html>
